# Build output — `tsc` output plus the copied renderer. Regenerated by `npm run
# build`; never committed, exactly as `web/.gitignore` treats `web/.next/`.
/dist/

# dependencies
/node_modules/

# Playwright's failure artefacts (traces, screenshots). The directory exists so
# a failed run leaves something a human can open, and nothing in it is source.
/test-results/
/playwright-report/