# ---- Dashboard configuration ----
#
# Copy to `.env.local` (gitignored) and edit. Never commit a filled-in copy:
# the token below is the API's operator credential, and the API can issue
# refunds. A committed token is a committed refund capability.

# Where the API is listening. This is the ONLY value with a NEXT_PUBLIC_ prefix,
# and it is a URL, not a credential. The browser bundle may know where the API
# is; it never learns how to authenticate to it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The operator token, read on the SERVER ONLY.
#
# No NEXT_PUBLIC_ prefix, and that is deliberate. A NEXT_PUBLIC_ variable is
# inlined into the JavaScript bundle at build time and is readable by anyone who
# opens the dashboard -- including any other page in the same browser, any
# extension with page access, and anyone who can fetch the bundle. Phase 1 is a
# single-operator local deployment, so the realistic exposure is small; it is
# not zero, and "it's only localhost" is the reasoning that ends with a
# credential in a build artefact. These endpoints issue refunds.
#
# Because it is not NEXT_PUBLIC_, it is read in Server Components and Route
# Handlers and never in the browser. All API calls therefore originate server
# side, which is what keeps the token out of the bundle.
#
# Must match the value the API process was started with. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSPILOT_OPERATOR_TOKEN=