# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# The example is documentation and carries no secret: it names the two
# variables and explains why the token has no NEXT_PUBLIC_ prefix, which is a
# decision a developer should not have to reverse-engineer from the code. Every
# real .env* stays ignored above -- only this one name is re-included.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
