# OpsPilot configuration.
#
# Copy to `.env` and fill in what you need. Every value below is read by
# `src/opspilot/settings.py`; `.env` is gitignored and `.env.example` must never
# contain a real secret. CI runs the whole suite with `MODEL_PROVIDER=fake` and
# needs no key at all.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL with pgvector, as docker-compose.yml provides it. This is the only
# supported runtime configuration, and it is required for the golden path: the
# worker and the API are two processes and must share a store.
#
# SQLite is a TESTS-ONLY path (docs/adr/0004), not a local-run option. On SQLite
# build_vector_store returns InMemoryVectorStore, which keeps embeddings in
# process memory -- so an API that reindexes and a worker that retrieves do not
# share vectors, and retrieval returns zero hits on every SQLite deployment. The
# run abstains and escalates while the reply still claims a resolution. Do not
# point a deployment at SQLite. See docs/limitations.md section 3.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. The API refuses to start without it rather than defaulting to open,
# because a default-open auth is worse than no auth -- it looks like auth.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSPILOT_OPERATOR_TOKEN=

# Comma-separated origins a BROWSER may read API responses from. The dashboard
# (M7) serves on http://localhost:3000 and the API on http://localhost:8000;
# without this the browser discards every response before the dashboard runs, so
# the default names exactly that one origin.
#
# READ THIS BEFORE CHANGING IT. Two things it is not:
#
#   * It is NOT who may CALL the API. Anything that can reach port 8000 can send
#     a request, with or without an Origin header -- curl has no CORS at all.
#     The bearer token above is what authorises a call; this only decides which
#     pages the browser will hand a response to.
#   * '*' IS REFUSED. The API will not start if it appears here. A wildcard lets
#     any page the operator visits while the API is running read every response,
#     and these endpoints can move money (docs/api-contract.md §5). Name the
#     origins instead.
#
# Empty is allowed and means "no cross-origin browser access at all" -- useful
# when the dashboard is served from the API's own origin. That is the opposite of
# allowing everything, and a config that reads empty is not misconfigured.
OPSPILOT_CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# fake | anthropic | openai
# `fake` replays recorded responses from evals/datasets/fixtures/ and needs no
# key. It is the default so that a fresh clone and the CI suite work, and it is
# what the deterministic demo runs on.
MODEL_PROVIDER=fake

MODEL_NAME=
# Left blank, each provider uses its own default:
#   anthropic -> claude-sonnet-5-5
#   openai    -> gpt-5.1
# Set it explicitly when an eval result needs to be reproducible.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Endpoint the OpenAI adapter points at. Left blank it uses the SDK's own
# endpoint (https://api.openai.com/v1), which is right for plain OpenAI.
#
# Set it to reach any server that speaks the OpenAI HTTP protocol -- a
# self-hosted vLLM, an Azure OpenAI deployment, Together, Groq, or OpenRouter
# (https://openrouter.ai/api/v1). Use the full base including the version path,
# e.g. https://openrouter.ai/api/v1 . The adapter passes this to the SDK only
# when it is non-empty, because an empty string is an invalid endpoint rather
# than "use the default".
OPENAI_BASE_URL=

# Endpoint the Anthropic adapter points at. Left blank it uses the SDK's own
# endpoint (https://api.anthropic.com).
#
# The Anthropic SDK already reads ANTHROPIC_BASE_URL from the environment
# itself, so setting this variable works even without the line below being read
# by this app -- but the worker threads it through explicitly rather than
# relying on the SDK's private precedence (kwarg > env > default).
#
# Set it to reach any server that speaks the Anthropic Messages protocol -- a
# self-hosted gateway, a proxy, or a local inference server. The adapter passes
# it to the SDK only when it is non-empty.
ANTHROPIC_BASE_URL=

# Which structured-output mechanism the Anthropic adapter uses.
#   output_config (default) -- native JSON-schema-constrained output. The
#     correct request for real Anthropic: a malformed reply is impossible.
#   tool                    -- forced tool use: declare one tool whose schema is
#     the target and force it, so the model's arguments arrive already
#     structured. For a gateway that accepts and ignores `output_config` (which
#     then answers with prose and fails validation). This makes a malformed
#     reply merely unlikely rather than impossible -- a different failure mode,
#     so it is opt-in and never selected silently.
# Leave it as output_config unless you are pointing at such a gateway.
ANTHROPIC_STRUCTURED_OUTPUT=output_config

# Request timeout for a single model call, seconds. Phase 1 has no retries: a
# timeout fails the run with a recorded reason rather than being retried.
MODEL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# local | openai
#
# `local` is a deterministic, dependency-free LEXICAL embedder: a bag of
# stopword-free, lightly-stemmed words weighted sublinearly by frequency and
# hashed into a fixed-width vector. It is genuinely a retriever on this corpus
# -- measured over evals/datasets/retrieval.jsonl it reaches Recall@5 14/15 and
# Recall@10 15/15, and its scores separate answerable from unanswerable
# questions -- which is what lets a fresh clone and CI run the golden path with
# no API key.
#
# What it is NOT: semantic. It has no synonymy, so a question whose answer is
# worded entirely differently from the question will not match it. Any number
# quoted in the README came from a run with a real embedding provider, and the
# run's config is recorded with it (docs/limitations.md section 3).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Below this similarity the run abstains and escalates rather than answering
# from weak evidence (docs/architecture.md section 9).
#
# THE DEFAULT DEPENDS ON THE EMBEDDER. The two are not interchangeable: the local
# lexical embedder's scores and a provider's cosine are different quantities on
# different scales.
#
#   local (the default): 0.22. Measured on evals/datasets/retrieval.jsonl, the
#     answerable cases score >= 0.2500 and the expect_abstention cases <= 0.1844,
#     so any value in that gap separates them. 0.22 sits inside it with margin
#     on both sides. This threshold really does discriminate: raise it to 0.25
#     and answerable questions start abstaining; lower it to 0.18 and
#     unanswerable ones stop abstaining.
#
#   openai: provider embeddings are near-unit cosine on a familiar corpus, so
#     something around 0.35 is the conservative starting point -- but it is a
#     DIFFERENT number for the same setting, and switching providers means
#     recalibrating against your own corpus, not inheriting this one.
#
# It is still a single global threshold, not a calibrated value -- see
# docs/limitations.md section 3.
RETRIEVAL_MIN_SCORE=0.22

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------
# Plan/execute rounds before a run is failed with `max_steps_exceeded`. An agent
# loop's failure mode is not a crash, it is a loop against a tool that mutates
# state.
MAX_STEPS=24

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Seconds between polls of the run table. The run table is the queue
# (docs/adr/0005); this is the added latency on every run.
WORKER_POLL_INTERVAL=1.0
# Unique per worker process. Recorded on claimed runs so a stuck run can be
# traced to the process that holds it.
WORKER_ID=

# ---------------------------------------------------------------------------
# MCP servers
# ---------------------------------------------------------------------------
# Where the gateway launches each server. Overridden in Docker, where the
# servers are siblings on the network rather than subprocesses of the worker.
MCP_CRM_COMMAND=python -m mcp_servers.crm.server
MCP_BILLING_COMMAND=python -m mcp_servers.billing.server
MCP_ISSUES_COMMAND=python -m mcp_servers.issues.server

# ---------------------------------------------------------------------------
# Tool policy
# ---------------------------------------------------------------------------
# Comma-separated tool names to refuse. This can only REMOVE capability, never
# grant it -- an unset or malformed value means nothing is denied, and there is
# no value of this variable that widens a permission. Config may take away; only
# code may give. (docs/adr/0003)
OPSPILOT_TOOL_DENYLIST=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Phase 1 stores full prompts and model responses in agent_steps. Dev mode leaves
# that on. Production redaction is Phase 3 and is listed in docs/limitations.md.
STORE_FULL_PROMPTS=true

# Which recorded fixture the `fake` provider replays, by scenario name.
#
# The `fake` provider answers from a named scenario's script or by matching the
# request hash against a fixture's recorded hash. Every shipped fixture records
# `request_hash: null`, so only the scenario path has data -- which means
# `MODEL_PROVIDER=fake` needs this to complete a run from a real process, not
# just from inside pytest.
#
# Available scenarios are the fixture filenames in evals/datasets/fixtures/:
#   duplicate_charge   the golden path -- classify, retrieve, three reads,
#                      propose a refund, park for approval, execute, reply
#   already_refunded   the duplicate was already refunded; no write proposed
#
# Left blank, the hash path is in charge and an unmatched request fails loudly.
# One process replays one scenario, so a single worker cannot demo both.
OPSPILOT_FAKE_SCENARIO=duplicate_charge
