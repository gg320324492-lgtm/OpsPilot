# OpsPilot configuration.
#
# Copy to `.env` and fill in what you need. Every value below is read by
# `src/opspilot/settings.py`; `.env` is gitignored and `.env.example` must never
# contain a real secret. CI runs the whole suite with `MODEL_PROVIDER=fake` and
# needs no key at all.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL with pgvector, as docker-compose.yml provides it.
# For a local run without Docker, SQLite works for everything except the worker
# concurrency claim and pgvector search -- see docs/adr/0004.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
# DATABASE_URL=sqlite+pysqlite:///./opspilot.db

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. The API refuses to start without it rather than defaulting to open,
# because a default-open auth is worse than no auth -- it looks like auth.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSPILOT_OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# fake | anthropic | openai
# `fake` replays recorded responses from evals/datasets/fixtures/ and needs no
# key. It is the default so that a fresh clone and the CI suite work, and it is
# what the deterministic demo runs on.
MODEL_PROVIDER=fake

MODEL_NAME=
# Left blank, each provider uses its own default:
#   anthropic -> claude-sonnet-5-5
#   openai    -> gpt-5.1
# Set it explicitly when an eval result needs to be reproducible.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Request timeout for a single model call, seconds. Phase 1 has no retries: a
# timeout fails the run with a recorded reason rather than being retried.
MODEL_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# local | openai
# `local` is a deterministic, dependency-free embedder. Its retrieval quality is
# poor and it exists so that a fresh clone and CI run with no API key -- it is
# plumbing, not a good embedder. Any number quoted in the README came from a run
# with a real embedding provider, and the run's config is recorded with it.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Below this cosine similarity the run abstains and escalates rather than
# answering from weak evidence. A single global threshold -- see
# docs/limitations.md section 3.
RETRIEVAL_MIN_SCORE=0.35

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------
# Plan/execute rounds before a run is failed with `max_steps_exceeded`. An agent
# loop's failure mode is not a crash, it is a loop against a tool that mutates
# state.
MAX_STEPS=24

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Seconds between polls of the run table. The run table is the queue
# (docs/adr/0005); this is the added latency on every run.
WORKER_POLL_INTERVAL=1.0
# Unique per worker process. Recorded on claimed runs so a stuck run can be
# traced to the process that holds it.
WORKER_ID=

# ---------------------------------------------------------------------------
# MCP servers
# ---------------------------------------------------------------------------
# Where the gateway launches each server. Overridden in Docker, where the
# servers are siblings on the network rather than subprocesses of the worker.
MCP_CRM_COMMAND=python -m mcp_servers.crm.server
MCP_BILLING_COMMAND=python -m mcp_servers.billing.server
MCP_ISSUES_COMMAND=python -m mcp_servers.issues.server

# ---------------------------------------------------------------------------
# Tool policy
# ---------------------------------------------------------------------------
# Comma-separated tool names to refuse. This can only REMOVE capability, never
# grant it -- an unset or malformed value means nothing is denied, and there is
# no value of this variable that widens a permission. Config may take away; only
# code may give. (docs/adr/0003)
OPSPILOT_TOOL_DENYLIST=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Phase 1 stores full prompts and model responses in agent_steps. Dev mode leaves
# that on. Production redaction is Phase 3 and is listed in docs/limitations.md.
STORE_FULL_PROMPTS=true
