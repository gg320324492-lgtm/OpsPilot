# ---- Secrets: never committed, under any circumstance ----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python bytecode / build artifacts ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ---- Test, lint, type caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage.xml
.coverage
coverage.json
htmlcov/

# ---- Database files ----
# The MCP servers each own a SQLite file when run outside Docker, and the local
# dev database is SQLite. These are seeded from committed JSON, so nothing here
# is a source of truth and none of it belongs in the repository.
*.db
*.sqlite
*.sqlite3
data/

# ---- Frontend ----
# The dashboard lives in web/. These are the bare directory names so the rule
# applies at any depth (web/node_modules, and any nested package if one is
# added), which is why they are written without a leading slash.
node_modules/
.next/
out/
.turbo/

# Next.js regenerates next-env.d.ts on every build; it describes the installed
# Next version rather than the project, so it is not source. tsconfig.json's
# `include` still references it so a fresh checkout type-checks after one build.
next-env.d.ts

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Local working notes ----
# Kept out of the repository. Unlike GigaXML, where docs/ was a private journal,
# OpsPilot's docs/ IS the specification and is committed -- so this directory is
# named for scratch work specifically and must not be confused with docs/.
.scratch/

# Eval runs produce one JSON per run plus a working database. The results
# directory is committed selectively: only the run the README quotes is added
# back, by explicit path. Everything else stays local, because a directory of
# every eval run is noise that grows without bound.
evals/results/*
!evals/results/.gitkeep
!evals/results/README.md

# ---- Alembic ----
# No local override; migrations are the artifact.

# MCP servers write their working copy of the seed database here when no
# OPSPILOT_MCP_DATA_DIR is set. The committed seed JSON is the source of truth;
# this directory is a runtime artefact and must never be committed.
.opspilot-data/
